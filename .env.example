# Database Configuration (SQLite default; can be migrated to PostgreSQL/MySQL)
DATABASE_URL="file:./dev.db"

# Admin Authentication
ADMIN_JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
ADMIN_EMAIL="admin@birdhillstech.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional AI Integration (Gemini / OpenAI API keys for enhanced assistant capabilities)
# System falls back gracefully to high-accuracy offline heuristic qualifier if keys are omitted
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
