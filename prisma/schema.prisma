generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("admin")
  avatar       String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model PageContent {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  contentJson    String   @db.LongText
  seoTitle       String?
  seoDescription String?  @db.Text
  updatedAt      DateTime @updatedAt
}

model Service {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  category       String
  shortDesc      String   @db.Text
  fullDesc       String   @db.Text
  icon           String
  featuresJson   String   @db.Text
  processJson    String?  @db.Text
  benefitsJson   String?  @db.Text
  seoTitle       String?
  seoDescription String?  @db.Text
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id             String         @id @default(uuid())
  title          String
  slug           String         @unique
  client         String
  industry       String
  category       String
  shortDesc      String         @db.Text
  description    String         @db.LongText
  challenge      String         @db.Text
  approach       String         @db.Text
  solution       String         @db.Text
  results        String         @db.Text
  servicesJson   String         @db.Text
  techJson       String         @db.Text
  featured       Boolean        @default(false)
  status         String         @default("published")
  coverImage     String         @db.Text
  seoTitle       String?
  seoDescription String?        @db.Text
  images         ProjectImage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String   @db.Text
  caption   String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?    @db.Text
  posts       BlogPost[]
}

model BlogPost {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  excerpt        String       @db.Text
  content        String       @db.LongText
  coverImage     String       @db.Text
  categoryId     String
  category       BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status         String       @default("published")
  author         String       @default("Bird Hills Tech Team")
  readTime       String       @default("5 min read")
  seoTitle       String?
  seoDescription String?      @db.Text
  publishedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Testimonial {
  id         String   @id @default(uuid())
  authorName String
  role       String
  company    String
  quote      String   @db.Text
  rating     Int      @default(5)
  avatarUrl  String?  @db.Text
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  category  String   @default("General")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  company   String?
  email     String
  phone     String?
  service   String?
  budget    String?
  message   String?  @db.Text
  source    String
  status    String   @default("New")
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id        String   @id @default(uuid())
  name      String
  company   String?
  email     String
  phone     String
  service   String
  date      String
  timeSlot  String
  message   String?  @db.Text
  status    String   @default("Pending")
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  company   String?
  email     String
  phone     String?
  service   String?
  budget    String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatConversation {
  id          String        @id @default(uuid())
  sessionId   String        @unique
  leadName    String?
  leadEmail   String?
  leadPhone   String?
  leadCompany String?
  status      String        @default("active")
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  text           String           @db.Text
  createdAt      DateTime         @default(now())
}

model Media {
  id        String   @id @default(uuid())
  name      String
  url       String   @db.Text
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
}

model PricingTier {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  badge        String?
  description  String   @db.Text
  priceAed     String
  priceUsd     String?
  billingType  String   @default("one-time")
  deliveryTime String?
  featuresJson String   @db.Text
  popular      Boolean  @default(false)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HostingPlan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  category     String   @default("cloud")
  priceUsd     String
  billingCycle String   @default("/ month")
  badge        String?
  description  String   @db.Text
  storage      String?
  bandwidth    String?
  featuresJson String   @db.Text
  popular      Boolean  @default(false)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
